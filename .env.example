RACK_ENV=development
APP_NAME=rack-api
LOG_LEVEL=INFO
PORT=3000
MIN_THREADS=5
MAX_THREADS=5
WEB_CONCURRENCY=0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_TIMEOUT=25
# Native development uses localhost; Compose overrides the hostname to redis.
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=1
ENABLE_EXAMPLE_JOBS=true
MAX_REQUEST_BYTES=1048576
# Comma-separated browser origins. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:3000
# bin/setup generates the API key and session secret; never commit real values.
CLIENT_API_KEY=
SIDEKIQ_WEB_ENABLED=true
SIDEKIQ_WEB_USERNAME=dev
SIDEKIQ_WEB_PASSWORD=dev
SIDEKIQ_WEB_SESSION_SECRET=
