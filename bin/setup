#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "securerandom"

root = File.expand_path("..", __dir__)
path = File.join(root, ".env")
FileUtils.cp(File.join(root, ".env.example"), path) unless File.exist?(path)
contents = File.read(path)
%w[CLIENT_API_KEY SIDEKIQ_WEB_SESSION_SECRET].each do |name|
  pattern = /^#{name}=(.*)$/
  current = contents.match(pattern)&.captures&.first.to_s.strip
  next unless ["", '""', "''"].include?(current)

  entry = "#{name}=#{SecureRandom.hex(64)}"
  if contents.match?(pattern)
    contents.sub!(pattern, entry)
  else
    contents << "\n" unless contents.end_with?("\n")
    contents << "#{entry}\n"
  end
end
File.write(path, contents)
File.chmod(0o600, path)
puts "Local environment configured. Existing credentials were preserved."
system("bundle", "install", chdir: root, exception: true) unless ARGV.include?("--env-only")
