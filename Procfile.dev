api: bundle exec rerun --background --pattern **/*.{rb} --dir api,handlers,jobs,lib,spec,tasks,validators -- ./bin/puma -C config/puma.rb
sidekiq: bundle exec rerun --background --pattern **/*.{rb} --dir api,handlers,jobs,lib,spec,tasks,validators -- ./bin/sidekiq -r ./config/sidekiq.rb -C config/sidekiq.yml
